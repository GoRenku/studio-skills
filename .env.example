# Copy to .env (git-ignored). The release scripts read it with node --env-file-if-exists=.env.

# The private key of the "renku-cloud-plugin release" deploy key on GoRenku/renku-cloud-plugin.
# The release pushes the built Renku Cloud plugin with it. A leading ~/ is your home folder.
RENKU_CLOUD_PLUGIN_DEPLOY_KEY=
